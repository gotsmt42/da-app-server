# ── da-app-server ────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับองค์กรของคุณ
# ✅ ระบบนี้ติดตั้งให้องค์กรไหนก็ได้ — ไม่มีชื่อบริษัทฝังอยู่ในโค้ดแล้ว

APP_DATABASE=mongodb://127.0.0.1:27017/da-app
APP_SECRET=เปลี่ยนเป็นค่าสุ่มที่ยาวและเดาไม่ได้
PORT=5000

# ── ข้อมูลองค์กร (ใช้เป็น "ค่าตั้งต้น" ตอนสร้างฐานข้อมูลครั้งแรกเท่านั้น) ──
# หลังติดตั้งแล้วแก้ได้จากหน้า ตั้งค่า > ตั้งค่าองค์กร โดยไม่ต้องแตะไฟล์นี้อีก
ORG_NAME_TH=องค์กรของคุณ
ORG_NAME_EN=YOUR ORGANIZATION
ORG_ADDRESS=
ORG_TAX_ID=
ORG_TEL=
ORG_EMAIL=
ORG_WEBSITE=

# ── อื่นๆ (ใส่เมื่อใช้งานจริง) ──
# CLOUDINARY_URL=
# FIREBASE_SERVICE_ACCOUNT=

# ── เว็บไซต์บริษัท (da-web) — ไม่ตั้งก็ได้ ระบบส่วนอื่นทำงานปกติ ──
# กุญแจร่วมกับเว็บไซต์ (ต้องตรงกับ LEAD_API_KEY ของ da-web) — สร้างด้วย: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LEAD_API_KEY=
# ส่งอีเมลแจ้งคำขอจากเว็บ (Gmail ต้องใช้ App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFY_EMAIL=
# ลิงก์แอปในอีเมลแจ้งเตือน เช่น https://app.example.com
APP_PUBLIC_URL=
# สั่งเว็บไซต์อัปเดตทันทีหลังบันทึกในหลังบ้าน (ต้องตรงกับ REVALIDATE_SECRET ของ da-web)
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
